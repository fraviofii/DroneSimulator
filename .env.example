# Copy to .env and adjust. Every variable has a default in docker-compose.yaml
# that reproduces the original single-instance layout, so in practice only
# EXTERNAL_IP has to be set.
#
# To run a SECOND stack alongside this one, copy this file to .env.sim2, change
# every value below (they are all either host-global or would cross-talk), and
# start it with a distinct project name:
#
#   docker compose -p sim2 --env-file .env.sim2 up -d

# ---------------------------------------------------------------- project ---
# Compose project name. Prefixes container and network names; must be unique
# per instance. Also pass it as `-p <name>` so the two always agree.
COMPOSE_PROJECT_NAME=sim1

# cam1/cam2 (today's synthetic test-pattern cameras) and gazebo/gzcam1/gzcam2
# (headless Gazebo Harmonic physics + cameras) are mutually-exclusive
# Compose profiles — see docker-compose.yaml's top-of-file comment. A
# service tagged `profiles:` does NOT start unless that profile is active,
# so COMPOSE_PROFILES=demo here is what makes a plain `docker compose up -d`
# still reproduce today's stack. To run the gazebo profile instead, override
# on the command line (shell/CLI env beats this file):
#   COMPOSE_PROFILES=gazebo SITL_MODEL=JSON:172.28.0.30 docker compose up -d
# See "Gazebo profile" in README for the full picture, including why
# SITL_MODEL has to be set alongside the profile switch.
COMPOSE_PROFILES=demo

# ----------------------------------------------------------------- network ---
# First two octets of the sim bridge network. Static service IPs become
# <NET_PREFIX>.0.10 (mavrouter), .0.11 (mediaserver), .0.20 (autopilot),
# .0.21/.0.22 (demo cams), .0.23 (serial), .0.30 (gazebo), .0.31/.0.32
# (gazebo cams). Each instance needs a distinct prefix: the subnet is a /16
# and Docker rejects overlapping address pools.
NET_PREFIX=172.28

# IPv6 ULA subnet for the same network. Must not overlap between instances.
NET6_SUBNET=fd00:df:5117::/64

# -------------------------------------------------------------- host ports ---
# Published on the host, so unique per instance. The router's in-container
# ports stay 24042/udp and 42024/tcp; only the host side moves.
ROUTER_UDP_PORT=24043
ROUTER_TCP_PORT=42024

# Media server. These move the listener INSIDE the container too (RTSP
# negotiates its RTP/RTCP ports in-band, so host and container must match).
RTSP_PORT=8554
RTP_PORT=8000
RTCP_PORT=8001

# ---------------------------------------------------------------- vehicle ---
# Serial number advertised via AUTOPILOT_VERSION and reported as `droneSerial`
# by kvs/forward_telemetry.py. Give each instance its own, or the two sims are
# indistinguishable downstream in DGCS/AWS.
SERIAL_NUMBER=0102030405061224

# How often (seconds) the serial service re-announces AUTOPILOT_VERSION
# unprompted. It is otherwise sent only on MAV_CMD_REQUEST_MESSAGE (once), so a
# single lost datagram on a lossy/external link loses the serial permanently.
# Set to 0 to disable and go back to request-only behaviour.
SERIAL_ANNOUNCE_PERIOD=5

# ArduPilot SITL frame model. "quad" (default) uses ArduPilot's own built-in
# physics -- the demo profile. The gazebo profile needs this pointed at the
# gazebo service's JSON FDM link instead: JSON:<NET_PREFIX>.0.30, e.g.
# JSON:172.28.0.30 for the default NET_PREFIX. Verified against ArduPilot's
# libraries/SITL/examples/JSON/readme.md ("--model JSON:127.0.0.1" embeds
# the physics-backend IP; no port is embeddable in this string, so a
# non-default GZ_FDM_IN_PORT/GZ_FDM_OUT_PORT below is not picked up here).
SITL_MODEL=quad

# -------------------------------------------------------------- gazebo ---
# Only used by the "gazebo" Compose profile (COMPOSE_PROFILES=gazebo above);
# ignored -- and never pulled -- by the default "demo" profile. None of
# these ports are published to the host; all traffic is container-to-
# container on the sim network.

# Image tag for ghcr.io/draganfly/gazebo-sitl, built by
# .github/workflows/gazebo-sitl.yaml on a `gazebo-v*` git tag.
GZ_TAG=latest

# ArduPilotPlugin JSON FDM link (see SITL_MODEL above). Defaults match
# ArduPilot's compiled-in --sim-port-in/--sim-port-out defaults (9003/9002)
# and ardupilot_gazebo's <fdm_port_in>9002</fdm_port_in> -- changing these
# without also changing the autopilot entrypoint's flags (out of scope of
# this compose file) will desync the link; see README "Gazebo profile".
GZ_FDM_IN_PORT=9002
GZ_FDM_OUT_PORT=9003

# RTP targets for the forward (gzcam1, port GZ_CAM1_RTP_PORT) and down
# (gzcam2, port GZ_CAM2_RTP_PORT) GstCameraPlugin sensors; gzcam1/gzcam2
# bridge these to RTSP on the mediaserver, same as the demo cams do.
GZ_CAM1_RTP_PORT=5600
GZ_CAM2_RTP_PORT=5601

# Render gate (blocker B2 fix, see gazebo/gazebo-sitl-plan.html and
# gazebo/docker/camera_gate.py). The gazebo container polls mediaserver's
# HTTP API (MTX_API, enabled below) for each camera path's reader count and
# enables/disables the matching Gazebo camera sensor itself -- MediaMTX
# never execs anything, so this works inside the stock `bluenviron/mediamtx`
# image with no custom build. Host is left empty so the script derives
# "<NET_PREFIX>.0.11" on its own; override only if mediaserver ever needs to
# live somewhere else. Comma-separated "<mediamtx path>:<gz enable topic>"
# pairs, matching the paths cam1/gzcam1 and cam2/gzcam2 publish to and the
# enable_topic values in models/iris_dual_cam/model.sdf.template.
GZ_CAMERA_GATE_MEDIASERVER_HOST=
GZ_CAMERA_GATE_MEDIASERVER_PORT=9997
GZ_CAMERA_GATE_INTERVAL=2
GZ_CAMERA_GATE_TIMEOUT=2
# Seconds of continuous zero readers before a camera is disabled (enable is
# immediate). The reader that triggers gzcam's placeholder->RTP switch is
# dropped BY that switch, and a real GCS briefly drops/reattaches on network
# hiccups -- disabling on the first zero-reader poll would tear the camera
# down mid-switch every time. Equivalent in spirit to MediaMTX's
# runOnDemandCloseAfter.
GZ_CAMERA_GATE_DISABLE_HOLD=10
GZ_CAMERA_GATE_PATHS=cam1:/cam1/enable,cam2:/cam2/enable

# Bootstrap placeholder (gzcam1/gzcam2 only; support-tools/demo_video_source.py).
# The render gate above enables a Gazebo camera once MediaMTX reports a reader
# on its path, but MediaMTX never reports a path -- let alone a reader -- for
# one with no active publisher, and gzcam can't publish real RTP until the
# still-disabled camera is enabled. Nothing would ever start. Fix: gzcam always
# publishes something -- a small placeholder pattern while there are 0 readers
# (or the real feed hasn't shown up yet), the real RTP passthrough once it has
# -- so the path always exists and a viewer always has something to attach to.
# See the module docstring in demo_video_source.py for the full picture.
GZ_CAM_PLACEHOLDER_WIDTH=320
GZ_CAM_PLACEHOLDER_HEIGHT=240
GZ_CAM_PLACEHOLDER_FPS=5
# Seconds to wait for real RTP after a reader attaches (the Gazebo camera
# takes a couple of seconds to start emitting frames once enabled) before
# giving up and reverting to the placeholder; retried on the next gate poll.
GZ_CAM_RTP_GRACE_PERIOD=8
# Seconds RTP mode is held open with zero readers before reverting to the
# placeholder. The reader that triggers the placeholder->RTP switch is
# dropped BY that switch, and the RTP publisher takes ~4-5s to come up
# (measured via mediamtx's session log) -- so this must comfortably cover
# that gap plus the viewer's reconnect cadence, or the switch can never
# complete and the stream flaps forever. Mirrors GZ_CAMERA_GATE_DISABLE_HOLD.
GZ_CAM_RTP_REVERT_HOLD=10
# Seconds between gzcam's own polls of its path's reader count. Independent
# of GZ_CAMERA_GATE_INTERVAL above (different process, different purpose --
# that one gates the Gazebo camera sensor, this one gates gzcam's own ffmpeg
# input) even though they default to the same cadence.
GZ_CAM_GATE_POLL_PERIOD=2
GZ_CAM_GATE_POLL_TIMEOUT=2
# Mediaserver API port gzcam polls -- deliberately reuses
# GZ_CAMERA_GATE_MEDIASERVER_PORT above rather than a second variable, since
# it's the same mediaserver and the same MTX_API port either way. The host
# is NOT a separate variable: gzcam derives it from its own --rtsp-uri
# (mediaserver is always the RTSP target, so it's always the right API host
# too).

# ------------------------------------------------------------------ video ---
# IP address that clients (and the cam services) use to reach the mediaserver;
# advertised to the GCS in each camera's VIDEO_STREAM_INFORMATION. Use
# 127.0.0.1 when the GCS runs on this machine (Docker Desktop does not expose
# published ports on the host's own LAN IP), or this host's externally
# reachable address when the GCS is on another machine.
EXTERNAL_IP=192.168.1.100
