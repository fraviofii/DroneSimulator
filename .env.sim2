# Second simulation instance. Start it with a matching project name:
#
#   docker compose -p sim2 --env-file .env.sim2 up -d
#   docker compose -p sim2 --env-file .env.sim2 down
#
# Every value here differs from .env — see .env.example for what each one does.
# `--env-file` REPLACES .env, so this file must be self-contained.

COMPOSE_PROJECT_NAME=sim2

# Network — must not overlap instance 1 (172.28.0.0/16, fd00:df:5117::/64).
NET_PREFIX=172.29
NET6_SUBNET=fd00:df:5118::/64

# Host ports.
ROUTER_UDP_PORT=25043
ROUTER_TCP_PORT=43024
RTSP_PORT=8555
RTP_PORT=8002
RTCP_PORT=8003
CAM1_HTTP_PORT=8093
CAM2_HTTP_PORT=8094

# Vehicle identity.
SERIAL_NUMBER=0102030405061225

# Site world (see .env.example): empty = built-in runway. Each instance can
# fly its own site.
SITE_LAT=
SITE_LON=

# Keep in sync with .env — this is the host address, not a per-instance value.
EXTERNAL_IP=192.168.144.31
