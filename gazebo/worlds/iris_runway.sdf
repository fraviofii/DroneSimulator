<?xml version="1.0" ?>
<!--
  Derived from ardupilot_gazebo's stock iris_runway.sdf
  (https://github.com/ArduPilot/ardupilot_gazebo/blob/main/worlds/iris_runway.sdf,
  fetched at commit 082a0fe231f6e63bc8d1598f1cba461d9e2ea7f5), per the locked
  "World" decision in gazebo/gazebo-sitl-plan.html: the plugin's own reference
  world, lightly dressed. Two changes from stock:
    1. model://iris_with_gimbal -> model://iris_dual_cam (our fixed
       forward+down camera airframe instead of the upstream gimbal demo).
    2. ~6 static landmarks added near the pad so the downward camera has
       something to look at other than featureless runway tarmac.
  Everything else (physics step, spherical_coordinates, lighting, the
  included runway model, the navsat-bearing "axes" model) is unmodified.
-->
<sdf version="1.9">
  <world name="iris_runway">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <cast_shadows>0</cast_shadows>
          <pose>5 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.01 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="g">
          <cast_shadows>0</cast_shadows>
          <pose>0 5 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="b">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.01 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
            <emissive>0 0 1 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!--
      Landmarks: six static boxes/cones scattered around the pad, close
      enough to be visible to camera_down (mounted ~0.03m below the body,
      pitched straight down) without fouling the rotor disks or the runway
      model included above. Positions are plain XY offsets from the origin
      the iris_dual_cam model below is spawned at; sizes/colours only need to
      be visually distinct from the grey tarmac and from each other.
    -->
    <model name="landmark_cone_1">
      <static>1</static>
      <pose>3 3 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.35 0.1 1</ambient>
            <diffuse>0.9 0.35 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="landmark_box_1">
      <static>1</static>
      <pose>-3 3 0 0 0 0.4</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.85 1</ambient>
            <diffuse>0.1 0.4 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="landmark_cone_2">
      <static>1</static>
      <pose>3 -3 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.35 0.1 1</ambient>
            <diffuse>0.9 0.35 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="landmark_box_2">
      <static>1</static>
      <pose>-3 -3 0 0 0 -0.4</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 1.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.1 1</ambient>
            <diffuse>0.85 0.85 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 1.4</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="landmark_box_3">
      <static>1</static>
      <pose>0 6 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.7 0.25 1</ambient>
            <diffuse>0.15 0.7 0.25 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.6 0.6</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="landmark_cone_3">
      <static>1</static>
      <pose>0 -6 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.6 0.1 0.75 1</ambient>
            <diffuse>0.6 0.1 0.75 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <include>
      <uri>model://iris_dual_cam</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

  </world>
</sdf>
