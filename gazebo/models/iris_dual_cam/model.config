<?xml version="1.0"?>
<model>
  <name>iris_dual_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Draganfly simulation_environment</name>
  </author>
  <description>
    ardupilot_gazebo's iris_with_standoffs airframe fitted with two fixed
    GstCameraPlugin cameras (camera_front, camera_down) instead of the
    upstream iris_with_gimbal/iris_with_ardupilot demo payloads. The
    ArduPilotPlugin control-channel block and rotor LiftDrag plugins are
    copied verbatim from ardupilot_gazebo's models/iris_with_ardupilot/
    model.sdf; only the ArduPilotPlugin FDM address/port and the two
    cameras' RTP destination host/port are project-specific.

    This directory ships model.sdf.template, not model.sdf: the FDM bind
    port and each camera's RTP destination are per-instance (NET_PREFIX-
    dependent) values that can't be baked into the image. See
    gazebo/docker/entrypoint.sh, which renders the template into
    /run/gazebo/models/iris_dual_cam/model.sdf at container start — that
    rendered copy, not this source directory, is what ends up on
    GZ_SIM_RESOURCE_PATH.
  </description>
</model>
