      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_3</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_3</link_name>
    </plugin>

    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_0_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_1_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_2_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_3_joint</joint_name>
    </plugin>

    <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
      <!--
        Port settings. fdm_addr binds 0.0.0.0 by default (see
        gazebo/docker/Dockerfile ENV), not upstream's example 127.0.0.1:
        arducopter runs in a separate container (the "autopilot" service) and
        must reach this plugin's UDP listener across the sim network, so it
        has to bind something other than loopback. fdm_port_out is
        deliberately NOT set here: verified against ArduPilotPlugin.cc, that
        parameter is deprecated on the Gazebo side — the reply address/port
        are learned from the first incoming packet
        (sock.get_client_address()). Whatever GZ_FDM_OUT_PORT the compose
        contract defines is consumed by arducopter's own SIM_JSON backend
        (the "autopilot" service's concern), not by this plugin.
      -->
      <fdm_addr>${GZ_FDM_ADDR}</fdm_addr>
      <fdm_port_in>${GZ_FDM_IN_PORT}</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <!-- Frame conventions
        Require by ArduPilot: change model and gazebo from XYZ to XY-Z coordinates
      -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>iris_with_standoffs::imu_link::imu_sensor</imuName>

      <!--
          incoming control command [0, 1]
          so offset it by 0 to get [0, 1]
          and divide max target by 1.
          offset = 0
          multiplier = 838 max rpm / 1 = 838
        -->
      <control channel="0">
        <jointName>iris_with_standoffs::rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="1">
        <jointName>iris_with_standoffs::rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="2">
        <jointName>iris_with_standoffs::rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

      <control channel="3">
        <jointName>iris_with_standoffs::rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>

    </plugin>

    <!--
      camera_front / camera_down: new links, not children spliced into the
      included iris_with_standoffs model (SDF composition doesn't allow
      injecting elements into an <include>d model) — the same pattern
      upstream itself uses to attach its (commented-out) rotor-blade debug
      markers to iris_with_standoffs links via a joint. Sensor pose omits any
      extra offset: verified against gz-sim's own example
      (examples/worlds/camera_sensor.sdf) that a <sensor type="camera"> with
      no <pose> looks along its link's local +X, which is exactly what
      "camera_front, rpy 0 0 0" and "camera_down, pitch 1.5708 (nose axis
      rotated onto -Z)" assume.

      enable_topic is set explicitly to /cam1/enable and /cam2/enable per
      this task's shared contract. Left at its default, GstCameraPlugin
      derives "<sensor's auto-assigned gz topic>/enable_streaming" instead
      (verified in GstCameraPlugin.cc) — a name MediaMTX's runOnDemand hook
      can't predict without duplicating Gazebo's own topic-scoping logic, so
      the override is required, not cosmetic.

      use_basic_pipeline is REQUIRED for the plan's RTP/SDP video bridge:
      left unset, GstCameraPlugin's default pipeline is MPEG-TS-over-UDP
      (mpegtsmux, verified in GstCameraPlugin.cc's CreateMpeg2tsPipeline()),
      not bare RTP. Only use_basic_pipeline=true selects
      CreateGenericPipeline() (rtph264pay + udpsink), which is what the
      demo_video_source.py rtp-source bridge expects to receive.

      always_on is 0 (B1, see gazebo-sitl-plan.html "Blockers"): the whole
      point of the render gate is that a disabled camera costs nothing, and
      <always_on>1</always_on> is gz-sensors' own override to force a sensor
      to render/update regardless of subscriber count — leaving it at 1
      would silently defeat docker/patches/0001-...patch's fix, which makes
      GstCameraPlugin's image-topic subscription (and therefore rendering)
      follow the enable_topic state.
    -->
    <link name="camera_front_link">
      <pose>0.10 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="camera_front" type="camera">
        <topic>cam1/image</topic>
        <gz_frame_id>camera_front_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>1500</far>
          </clip>
        </camera>
        <always_on>0</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>

        <plugin name="GstCameraPlugin"
            filename="GstCameraPlugin">
          <udp_host>${GZ_CAM1_HOST}</udp_host>
          <udp_port>${GZ_CAM1_RTP_PORT}</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
          <enable_topic>/cam1/enable</enable_topic>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_front_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>camera_front_link</child>
    </joint>

    <link name="camera_down_link">
      <pose>0.00 0 -0.03 0 1.5708 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="camera_down" type="camera">
        <topic>cam2/image</topic>
        <gz_frame_id>camera_down_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>1500</far>
          </clip>
        </camera>
        <always_on>0</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>

        <plugin name="GstCameraPlugin"
            filename="GstCameraPlugin">
          <udp_host>${GZ_CAM2_HOST}</udp_host>
          <udp_port>${GZ_CAM2_RTP_PORT}</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
          <enable_topic>/cam2/enable</enable_topic>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_down_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>camera_down_link</child>
    </joint>

  </model>
</sdf>
