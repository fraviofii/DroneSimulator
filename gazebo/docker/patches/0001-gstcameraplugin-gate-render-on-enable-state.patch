+// --- B1 patch ---
+void GstCameraPlugin::Impl::SubscribeImage()
+{
+    std::lock_guard<std::mutex> lock(imageSubMutex);
+    if (!imageSubscribed)
+    {
+        node.Subscribe(imageTopic, &GstCameraPlugin::Impl::OnImage, this);
+        imageSubscribed = true;
+    }
+}
+
+void GstCameraPlugin::Impl::UnsubscribeImage()
+{
+    std::lock_guard<std::mutex> lock(imageSubMutex);
+    if (imageSubscribed)
+    {
+        node.Unsubscribe(imageTopic);
+        imageSubscribed = false;
+    }
+}
+
+void GstCameraPlugin::Impl::ReconcileStreamingState()
+{
+    // Runs on the simulation thread every PreUpdate. OnVideoStreamEnable()
+    // only records desiredStreaming; acting on it here keeps every
+    // node.Subscribe()/node.Unsubscribe() call and every GStreamer-thread
+    // join off the gz-transport callback thread (v1 of this patch did both
+    // inside the callback and intermittently wedged message dispatch), and
+    // makes repeated publishes of the same state idempotent, so a gate
+    // that re-publishes its desired state periodically is safe.
+    const bool desired = desiredStreaming.load();
+
+    if (desired)
+    {
+        {
+            std::lock_guard<std::mutex> lock(imageSubMutex);
+            if (imageSubscribed)
+            {
+                return;
+            }
+        }
+        // Subscribing is what turns rendering on (gz-sensors renders only
+        // while the image topic has connections); OnImage() then starts
+        // the GStreamer thread on the first frame, when the actual width/
+        // height are known.
+        requestedStartStreaming = true;
+        SubscribeImage();
+    }
+    else
+    {
+        requestedStartStreaming = false;
+        // Unsubscribe first: connection count drops to zero and gz-sensors
+        // stops rendering this camera -- the CPU cost the render gate
+        // exists to eliminate.
+        UnsubscribeImage();
+        // Then stop the encode thread, if its main loop is up. A GStreamer
+        // thread still mid-initialisation (spawned by OnImage, main loop
+        // not yet running) can't be stopped this tick; isGstMainLoopActive
+        // flips true a moment later and the next PreUpdate pass lands
+        // here again and stops it then.
+        if (isGstMainLoopActive)
+        {
+            StopStreaming();
+        }
+    }
 }
+// --- end B1 patch ---
 
