# This repo is developed on Windows with core.autocrlf=true, but almost
# everything here is consumed inside a Linux container. Without these rules a
# commit + fresh checkout silently rewrites LF to CRLF, and:
#
#   - a CRLF shebang makes the kernel look for an interpreter literally named
#     "/bin/bash\r"  ->  "/bin/bash^M: bad interpreter: No such file or directory"
#   - envsubst/gz parse the trailing \r as part of SDF values
#
# Force LF for every file that crosses into a container.
*.sh        text eol=lf
*.py        text eol=lf
*.sdf       text eol=lf
*.template  text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf
*.patch     text eol=lf

# Generated Gazebo site worlds (gazebo/make_gz_world.py): meshes/materials are
# read by gz inside the container; STL may be binary, textures are images.
*.obj       text eol=lf
*.mtl       text eol=lf
*.config    text eol=lf
*.stl       binary
*.png       binary
